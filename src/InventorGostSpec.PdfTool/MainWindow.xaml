<Window x:Class="InventorGostSpec.PdfTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Спецификация в PDF по ГОСТ"
        Width="620" SizeToContent="Height" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        Background="#F5F6F8" FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Foreground" Value="#374151" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="Файл Excel, выгруженный из окна спецификации InventorGostSpec (можно поправить вручную). Файл можно перетащить в это окно."
                   TextWrapping="Wrap" Foreground="#6B7280" Margin="0,0,0,12" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Style="{StaticResource Label}" Text="Excel" />
            <TextBox x:Name="InputBox" Grid.Column="1" TextChanged="OnInputChanged" />
            <Button Grid.Column="2" Content="Обзор…" Margin="8,0,0,0" Click="OnBrowseInput" />

            <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="PDF" />
            <TextBox x:Name="OutputBox" Grid.Row="2" Grid.Column="1" />
            <Button Grid.Row="2" Grid.Column="2" Content="Обзор…" Margin="8,0,0,0" Click="OnBrowseOutput" />

            <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Шрифт" />
            <ComboBox x:Name="FontBox" Grid.Row="4" Grid.Column="1" IsEditable="True" Padding="4,3"
                      ToolTip="Шрифт ГОСТ 2.304: «GOST type B», «GOST type A» (КОМПАС-3D), ISOCPEUR (AutoCAD) или путь к файлу .ttf. «Автоматически» — шрифт Gost merged, поставляемый с утилитой." />
            <TextBlock x:Name="FontHint" Grid.Row="5" Grid.Column="1" Foreground="#6B7280" Margin="0,4,0,0" TextWrapping="Wrap" />
        </Grid>

        <GroupBox Header="Размеры шрифтов (высота прописных букв, мм) и сужение текста" Margin="0,14,0,0" Padding="8,6">
            <StackPanel>
                <UniformGrid x:Name="SizesGrid" Columns="2" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap"
                               Text="Допустимое сужение текста по ширине, % (100 — не сужать; 0 — автоматически не переносить, только по Alt+Enter)" />
                    <TextBox x:Name="MinWidthBox" Grid.Column="1" />
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap"
                               Text="Допустимое сужение в графе «Примечание», %" />
                    <TextBox x:Name="NoteMinWidthBox" Grid.Column="1" />
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap"
                               Text="Длинное слово в «Примечании» сужается до, % (дальше — перенос по слогам: «термооб-работка»)" />
                    <TextBox x:Name="WordMinWidthBox" Grid.Column="1" />
                </Grid>
                <Button Content="По умолчанию" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnResetSizes"
                        ToolTip="Вернуть размеры шрифтов и сужение по умолчанию (как в бланке КОМПАС-3D). Шрифт не меняется." />
            </StackPanel>
        </GroupBox>

        <CheckBox x:Name="OpenBox" Margin="0,12,0,0" Content="Открыть PDF после создания" />

        <Border Margin="0,14,0,0" Padding="10,8" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="3"
                x:Name="StatusPanel" Visibility="Collapsed">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Разметить листы в Excel" Margin="0,0,8,0" Click="OnMarkSheets"
                    ToolTip="Отметить в файле Excel границы листов PDF: жирная линия под последней строкой листа и номер листа в колонке «Лист PDF». Нужно после ручной правки. Файл Excel должен быть закрыт." />
            <Button x:Name="CreateButton" Content="Создать PDF" IsDefault="True" Click="OnCreate" FontWeight="SemiBold" />
            <Button Content="Закрыть" IsCancel="True" Margin="8,0,0,0" Click="OnClose" />
        </StackPanel>
    </StackPanel>
</Window>
