<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:InventorGostSpec.UI.Controls">

    <!-- Палитра окна: тёмный текст на светлом фоне, заметные границы (контраст текста не ниже 7:1). -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#1F6FD1" />
    <SolidColorBrush x:Key="Brush.AccentDark" Color="#1558AA" />
    <SolidColorBrush x:Key="Brush.Text" Color="#111827" />
    <SolidColorBrush x:Key="Brush.Muted" Color="#4B5563" />
    <SolidColorBrush x:Key="Brush.Bar" Color="#E9EDF2" />
    <SolidColorBrush x:Key="Brush.BarBorder" Color="#B8C1CC" />
    <SolidColorBrush x:Key="Brush.Panel" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.PanelTitle" Color="#DDE3EA" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#DCE8F7" />
    <SolidColorBrush x:Key="Brush.HoverBorder" Color="#8DB3E4" />

    <!-- Таблица. -->
    <SolidColorBrush x:Key="Brush.GridLine" Color="#D0D6DE" />
    <SolidColorBrush x:Key="Brush.GridHeader" Color="#DFE5EC" />
    <SolidColorBrush x:Key="Brush.GridHeaderLine" Color="#8C97A6" />
    <SolidColorBrush x:Key="Brush.SectionRow" Color="#EEF2F6" />
    <SolidColorBrush x:Key="Brush.GroupRow" Color="#D6E5F7" />
    <SolidColorBrush x:Key="Brush.GroupText" Color="#0B3B7A" />
    <SolidColorBrush x:Key="Brush.Selected" Color="#BFD6F6" />
    <SolidColorBrush x:Key="Brush.Reserve" Color="#8A94A3" />
    <SolidColorBrush x:Key="Brush.Overridden" Color="#1D4ED8" />

    <!-- Состояние строки: фон строки и метка (фон, текст). -->
    <SolidColorBrush x:Key="Brush.NewRow" Color="#DDF6E3" />
    <SolidColorBrush x:Key="Brush.NewBadge" Color="#16A34A" />
    <SolidColorBrush x:Key="Brush.ChangedRow" Color="#FFF1C7" />
    <SolidColorBrush x:Key="Brush.ChangedBadge" Color="#C27803" />
    <SolidColorBrush x:Key="Brush.RemovedRow" Color="#FCE1E1" />
    <SolidColorBrush x:Key="Brush.RemovedBadge" Color="#C81E1E" />
    <SolidColorBrush x:Key="Brush.ManualBadge" Color="#5B6472" />
    <SolidColorBrush x:Key="Brush.Unsaved" Color="#B45309" />

    <!-- Кнопка со значком и подписью. -->
    <Style TargetType="controls:IconButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:IconButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="3" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <StackPanel x:Name="Content" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image x:Name="Img" Source="{TemplateBinding Icon}" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Text}" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter TargetName="Txt" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Img" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Txt" Property="Margin" Value="0" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsPrimary" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.HoverBorder}" />
                        </MultiTrigger>
                        <Trigger Property="IsPrimary" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Txt" Property="Foreground" Value="White" />
                            <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsPrimary" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentDark}" />
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Content" Property="Opacity" Value="0.35" />
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Группа команд как панель ленты Inventor: белая карточка с кнопками, снизу полоса с названием группы. -->
    <Style x:Key="CommandGroup" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="3,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.BarBorder}" BorderThickness="1"
                            CornerRadius="3" SnapsToDevicePixels="True">
                        <DockPanel>
                            <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.PanelTitle}" CornerRadius="0,0,2,2" Padding="8,1,8,2">
                                <TextBlock Text="{TemplateBinding Header}" HorizontalAlignment="Center"
                                           FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Muted}" />
                            </Border>
                            <ContentPresenter Margin="3,4" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Метка состояния строки: «новый», «изменён», «нет в сборке», «вручную». -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="7,1,7,2" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Обычная кнопка диалога. -->
    <Style x:Key="DialogButton" TargetType="Button">
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
</ResourceDictionary>
