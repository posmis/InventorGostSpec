<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:InventorGostSpec.UI.Controls">

    <SolidColorBrush x:Key="Brush.Accent" Color="#2E7DD1" />
    <SolidColorBrush x:Key="Brush.AccentDark" Color="#1C5F9E" />
    <SolidColorBrush x:Key="Brush.Bar" Color="#F5F6F8" />
    <SolidColorBrush x:Key="Brush.BarBorder" Color="#D9DDE3" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#E3ECF7" />
    <SolidColorBrush x:Key="Brush.HoverBorder" Color="#B7CDE8" />
    <SolidColorBrush x:Key="Brush.Muted" Color="#6B7280" />

    <!-- Кнопка со значком и подписью. -->
    <Style TargetType="controls:IconButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#1F2937" />
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:IconButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="3" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <StackPanel x:Name="Content" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image x:Name="Img" Source="{TemplateBinding Icon}" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Text}" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter TargetName="Txt" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Img" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Txt" Property="Margin" Value="0" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsPrimary" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.HoverBorder}" />
                        </MultiTrigger>
                        <Trigger Property="IsPrimary" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Txt" Property="Foreground" Value="White" />
                            <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsPrimary" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentDark}" />
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Content" Property="Opacity" Value="0.35" />
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Группа команд: кнопки, под ними подпись группы, справа разделитель. -->
    <Style x:Key="CommandGroup" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border BorderBrush="{StaticResource Brush.BarBorder}" BorderThickness="0,0,1,0" Padding="6,4,6,2" Margin="0,4">
                        <StackPanel>
                            <ContentPresenter />
                            <TextBlock Text="{TemplateBinding Header}" HorizontalAlignment="Center" Margin="0,3,0,0"
                                       FontSize="11" Foreground="{StaticResource Brush.Muted}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Обычная кнопка диалога. -->
    <Style x:Key="DialogButton" TargetType="Button">
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
</ResourceDictionary>
