<Window x:Class="InventorGostSpec.UI.Views.AssignSectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Раздел спецификации"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,8,4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="DisplayMemberPath" Value="Name" />
        </Style>
        <DataTemplate x:Key="FieldTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="{Binding Label}" />
                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                <!-- Текущее значение (например, из наименования), если поле не заполнено вручную. -->
                <TextBlock Grid.Column="1" Margin="6,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="#9CA3AF" FontStyle="Italic" Text="{Binding CurrentValue}"
                           Visibility="{Binding ShowCurrentValue, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Grid.Column="1" Margin="6,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="Gray" Text="(разные значения)">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMixed}" Value="True" />
                                        <Condition Binding="{Binding IsChanged}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <StackPanel Margin="12">
        <TextBlock Text="{Binding TargetDescription}" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Раздел" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" />
        </Grid>

        <ContentControl Content="{Binding Format}" ContentTemplate="{StaticResource FieldTemplate}" />
        <ContentControl Content="{Binding Unit}" ContentTemplate="{StaticResource FieldTemplate}" />
        <ContentControl Content="{Binding FirstUse}" ContentTemplate="{StaticResource FieldTemplate}"
                        ToolTip="Обозначение изделия, в которое компонент вошёл впервые. Хранится в файле компонента (SPEC_FirstUse)." />

        <!-- Блок всегда на месте (размер окна не меняется), неактивен, если разделу не нужен. -->
        <GroupBox Header="Сортировка по ГОСТ" Margin="0,8,0,0" Padding="6" IsEnabled="{Binding ShowProductFields}">
            <StackPanel>
                <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,4"
                           Text="Нужны только стандартным, прочим изделиям и материалам.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowProductFields}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Grid IsEnabled="{Binding ShowMaterialFields}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="148" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Вид материала" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding MaterialKinds}" SelectedItem="{Binding SelectedMaterialKind}" />
                </Grid>
                <ContentControl Content="{Binding Group}" ContentTemplate="{StaticResource FieldTemplate}" />
                <ContentControl Content="{Binding SortName}" ContentTemplate="{StaticResource FieldTemplate}" />
                <ContentControl Content="{Binding StandardNumber}" ContentTemplate="{StaticResource FieldTemplate}" />
                <ContentControl Content="{Binding Parameters}" ContentTemplate="{StaticResource FieldTemplate}" />
                <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Пустые поля заполняются из наименования, например «Болт М12х60 ГОСТ 7798-70». Серым — что сейчас идёт в спецификацию." />
            </StackPanel>
        </GroupBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="ОК" Width="90" IsDefault="True" Click="OnOk" />
            <Button Content="Отмена" Width="90" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
