<Window x:Class="InventorGostSpec.UI.Views.ConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="13">
    <StackPanel Margin="16">
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="⚠" FontSize="28" Foreground="#B45309" Margin="0,0,12,0" VerticalAlignment="Top" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#111827" />
        </DockPanel>
        <Border Margin="0,14,0,0" Padding="10,8" Background="#FFF7E6" BorderBrush="#F2C46D" BorderThickness="1" CornerRadius="3">
            <CheckBox x:Name="ConfirmBox" IsChecked="{Binding IsConfirmed}" FontWeight="SemiBold">
                <TextBlock Text="{Binding CheckText}" TextWrapping="Wrap" />
            </CheckBox>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{Binding ActionText}" MinWidth="110" Padding="12,4" IsDefault="True" Click="OnRun"
                    IsEnabled="{Binding IsConfirmed}" />
            <Button Content="Отмена" MinWidth="90" Padding="12,4" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
