<Window x:Class="InventorGostSpec.UI.Views.GroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Группа «устанавливаемые по …»"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"
                   Text="Составные части, устанавливаемые по отдельному документу (например, электромонтажному чертежу), записываются после основной части спецификации под этим заголовком, со своими разделами. Номера позиций продолжаются подряд после основной части." />
        <TextBlock Text="Заголовок (графа «Наименование»)" />
        <TextBox x:Name="TitleBox" Margin="0,4,0,8" Padding="2" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="ОК" Width="90" IsDefault="True" Click="OnOk" />
            <Button Content="Отмена" Width="90" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
