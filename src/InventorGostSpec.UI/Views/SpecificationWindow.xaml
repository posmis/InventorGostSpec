<Window x:Class="InventorGostSpec.UI.Views.SpecificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:InventorGostSpec.UI.Controls"
        Title="{Binding Title}"
        Width="1320"
        Height="800"
        MinWidth="960"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="13"
        Foreground="#111827"
        Background="White">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/InventorGostSpec.UI;component/Themes/Icons.xaml" />
                <ResourceDictionary Source="/InventorGostSpec.UI;component/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <!-- Колонка состояния: цветная метка вместо серого текста. -->
            <DataTemplate x:Key="StatusCell">
                <Border x:Name="Badge" Style="{StaticResource Badge}" Visibility="Collapsed">
                    <TextBlock x:Name="BadgeText" Style="{StaticResource BadgeText}" />
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsManual}" Value="True">
                        <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Badge" Property="Background" Value="{StaticResource Brush.ManualBadge}" />
                        <Setter TargetName="BadgeText" Property="Text" Value="вручную" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsChanged}" Value="True">
                        <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Badge" Property="Background" Value="{StaticResource Brush.ChangedBadge}" />
                        <Setter TargetName="BadgeText" Property="Text" Value="изменён" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsNew}" Value="True">
                        <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Badge" Property="Background" Value="{StaticResource Brush.NewBadge}" />
                        <Setter TargetName="BadgeText" Property="Text" Value="новый" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                        <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Badge" Property="Background" Value="{StaticResource Brush.RemovedBadge}" />
                        <Setter TargetName="BadgeText" Property="Text" Value="нет в сборке" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFileChanged}" Value="True">
                        <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Badge" Property="Background" Value="{StaticResource Brush.ChangedBadge}" />
                        <Setter TargetName="BadgeText" Property="Text" Value="файл изменён" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
            <Style TargetType="Image" x:Key="MenuIcon">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding UpdateFromAssemblyCommand}" />
        <KeyBinding Key="F3" Command="{Binding NextChangeCommand}" />
        <KeyBinding Modifiers="Alt" Key="Enter" Command="{Binding EditComponentCommand}" />
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCommand}" />
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoCommand}" />
        <KeyBinding Modifiers="Control" Key="Y" Command="{Binding RedoCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="Z" Command="{Binding RedoCommand}" />
        <KeyBinding Key="F7" Command="{Binding CheckCommand}" />
        <KeyBinding Key="Insert" Command="{Binding AddItemCommand}" />
        <KeyBinding Modifiers="Control" Key="T" Command="{Binding AddNoteCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteRowCommand}" />
        <KeyBinding Modifiers="Control" Key="Up" Command="{Binding MoveUpCommand}" />
        <KeyBinding Modifiers="Control" Key="Down" Command="{Binding MoveDownCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Панель команд, сгруппированная по смыслу. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Bar}" BorderBrush="{StaticResource Brush.BarBorder}" BorderThickness="0,0,0,1">
            <DockPanel Margin="4,0">
                <!-- Поиск -->
                <Border DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,6,0" Width="280" Height="28"
                        Background="White" BorderBrush="{StaticResource Brush.BarBorder}" BorderThickness="1" CornerRadius="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Source="{StaticResource Icon.Search}" Width="14" Height="14" Margin="7,0,4,0" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" VerticalContentAlignment="Center" Background="Transparent"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                 ToolTip="Поиск по обозначению, наименованию, примечанию, позиции (Ctrl+F). Esc — очистить." />
                        <TextBlock Grid.Column="1" Margin="3,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="#9CA3AF" Text="Поиск (Ctrl+F)">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <controls:IconButton Grid.Column="2" Icon="{StaticResource Icon.Close}" Padding="3" Margin="0,0,2,0"
                                             Command="{Binding ClearSearchCommand}" ToolTip="Очистить поиск (Esc)"
                                             Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>

                <WrapPanel>
                    <HeaderedContentControl Style="{StaticResource CommandGroup}" Header="Правка">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconButton Icon="{StaticResource Icon.Undo}" Command="{Binding UndoCommand}" ToolTip="{Binding UndoToolTip}" />
                            <controls:IconButton Icon="{StaticResource Icon.Redo}" Command="{Binding RedoCommand}" ToolTip="{Binding RedoToolTip}" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Style="{StaticResource CommandGroup}" Header="Сборка">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconButton Icon="{StaticResource Icon.Refresh}" Text="Обновить из сборки" Command="{Binding UpdateFromAssemblyCommand}"
                                                 ToolTip="Прочитать состав сборки (F5). Ручной порядок, ручные строки, примечания и правки сохраняются." />
                            <controls:IconButton Icon="{StaticResource Icon.NextChange}" Text="Следующее изменение" Command="{Binding NextChangeCommand}"
                                                 ToolTip="Перейти к следующей подсвеченной строке (F3)" />
                            <controls:IconButton Icon="{StaticResource Icon.Formats}" Text="Форматы" Command="{Binding DrawingFormatsCommand}"
                                                 ToolTip="Найти чертежи деталей (выбранных строк или всех деталей) и записать форматы всех их листов в свойства деталей: «А1, А2х3, А2» в порядке уменьшения" />
                            <controls:IconButton Icon="{StaticResource Icon.Accept}" Text="Сбросить уведомления" Command="{Binding AcceptChangesCommand}"
                                                 ToolTip="Снять все отметки: «новый», «изменён», «файл изменён» (у сторонних документов запоминается их текущее содержимое, ссылки не меняются) и удалить строки компонентов, которых нет в сборке" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Style="{StaticResource CommandGroup}" Header="Строки">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconButton Icon="{StaticResource Icon.Properties}" Text="Свойства" Command="{Binding EditComponentCommand}"
                                                 ToolTip="Свойства компонента: раздел, формат, единица, поля сортировки (Alt+Enter). Записываются в iProperties детали." />
                            <controls:IconButton Icon="{StaticResource Icon.AddItem}" Text="Изделие" Command="{Binding AddItemCommand}"
                                                 ToolTip="Добавить строку изделия без модели после выбранной (Insert). Номер позиции — из резерва раздела." />
                            <controls:IconButton Icon="{StaticResource Icon.AddText}" Text="Текст" Command="{Binding AddNoteCommand}"
                                                 ToolTip="Добавить текстовую строку после выбранной (Ctrl+T)" />
                            <controls:IconButton Icon="{StaticResource Icon.Delete}" Command="{Binding DeleteRowCommand}"
                                                 ToolTip="Удалить ручную строку или строку компонента, которого нет в сборке (Delete)" />
                            <controls:IconButton Icon="{StaticResource Icon.Up}" Command="{Binding MoveUpCommand}"
                                                 ToolTip="Переместить вверх внутри раздела (Ctrl+↑). Можно перетаскивать за «⋮⋮»." />
                            <controls:IconButton Icon="{StaticResource Icon.Down}" Command="{Binding MoveDownCommand}"
                                                 ToolTip="Переместить вниз внутри раздела (Ctrl+↓)" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Style="{StaticResource CommandGroup}" Header="Структура">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconButton Icon="{StaticResource Icon.Section}" Text="Раздел ▾" Click="OnSectionMenuClick"
                                                 ToolTip="Вставить раздел, которого нет (например, «Документация»): он показывается заголовком и резервными строками. «Новый раздел…» — свой раздел для этой спецификации или общего справочника." />
                            <controls:IconButton Icon="{StaticResource Icon.RestoreValue}" Text="Разделы по умолчанию" Command="{Binding ResetSectionsCommand}"
                                                 ToolTip="Сбросить разделы компонентов (выбранных строк или всех) к разделам по умолчанию: удалить SPEC_Section из файлов и ручной перенос — раздел по типу компонента. Стандартные изделия не трогаются." />
                            <controls:IconButton Icon="{StaticResource Icon.Group}" Text="Группа" Command="{Binding AddGroupCommand}"
                                                 ToolTip="Добавить группу «Изделия, устанавливаемые по …» (например, по электромонтажному чертежу)" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Style="{StaticResource CommandGroup}" Header="Позиции">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconButton Icon="{StaticResource Icon.Sort}" Text="По ГОСТ" Command="{Binding ResetCommand}"
                                                 ToolTip="Сбросить ручной порядок: отсортировать по ГОСТ 2.106 и перенумеровать позиции" />
                            <controls:IconButton Icon="{StaticResource Icon.Renumber}" Text="Перенумеровать" Command="{Binding RenumberCommand}"
                                                 ToolTip="Перенумеровать позиции в текущем порядке строк с учётом резерва" />
                            <controls:IconButton Icon="{StaticResource Icon.Reserve}" Text="Резерв" Command="{Binding ReservesCommand}"
                                                 ToolTip="Резерв номеров позиций по разделам — для основной части и каждой группы" />
                            <CheckBox Margin="6,0,2,0" VerticalAlignment="Center" IsChecked="{Binding ShowReserveRows}" Content="Показывать резерв"
                                      ToolTip="Показывать пустые строки резервных позиций" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Style="{StaticResource CommandGroup}" Header="Вывод">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconButton Icon="{StaticResource Icon.Check}" Text="Проверка" Command="{Binding CheckCommand}"
                                                 ToolTip="Проверить спецификацию перед выпуском (F7): позиции, обязательные графы, повторы обозначений, расхождения с BOM Inventor, основная надпись" />
                            <controls:IconButton Icon="{StaticResource Icon.Excel}" Text="Excel" Command="{Binding ExportExcelCommand}"
                                                 ToolTip="Выгрузить спецификацию в Excel: для ручной правки и вывода в PDF по ГОСТ. Резервные строки выгружаются, если включено «Показывать резерв»." />
                            <controls:IconButton Icon="{StaticResource Icon.Settings}" Text="Настройки PDF" Command="{Binding PdfSettingsCommand}"
                                                 ToolTip="Настройки PDF: шрифт, размеры шрифтов, допустимое сужение текста. Открывает окно утилиты PDF; настройки действуют и для кнопки «PDF», и для разметки листов в Excel." />
                            <controls:IconButton Icon="{StaticResource Icon.Pdf}" Text="PDF" Command="{Binding ExportPdfCommand}"
                                                 ToolTip="Спецификация в PDF по ГОСТ 2.106 (формы 1 и 1а, основные надписи 2 и 2а). Изменения в основную надпись берутся из листа «Изменения» файла Excel рядом со сборкой. Шрифт — в утилите PDF." />
                            <controls:IconButton Icon="{StaticResource Icon.Balloon}" Text="Позиции в BOM" Command="{Binding WritePositionsCommand}"
                                                 ToolTip="Сохранить спецификацию и записать номера позиций в спецификацию Inventor (BOM), чтобы выноски совпадали" />
                        </StackPanel>
                    </HeaderedContentControl>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Нижняя панель: состояние, легенда, сохранение. -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.Bar}" BorderBrush="{StaticResource Brush.BarBorder}" BorderThickness="0,1,0,0" Padding="10,7">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" Foreground="{StaticResource Brush.Unsaved}"
                               Text="● Не сохранено" ToolTip="Есть изменения, не записанные в сборку (Ctrl+S)"
                               Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                    <controls:IconButton IsPrimary="True" Text="Сохранить" Padding="18,6" Command="{Binding SaveCommand}"
                                         ToolTip="Записать спецификацию в файл сборки (Ctrl+S). Затем сохраните сборку." />
                    <controls:IconButton Text="Закрыть" Padding="14,6" Margin="6,0,0,0" Click="OnCloseClick"
                                         BorderBrush="{StaticResource Brush.BarBorder}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                    <Border Width="1" Background="{StaticResource Brush.BarBorder}" Margin="14,2" />
                    <Border Style="{StaticResource Badge}" Background="{StaticResource Brush.NewBadge}">
                        <TextBlock Style="{StaticResource BadgeText}" Text="новый" />
                    </Border>
                    <Border Style="{StaticResource Badge}" Background="{StaticResource Brush.ChangedBadge}" Margin="5,0,0,0">
                        <TextBlock Style="{StaticResource BadgeText}" Text="изменён" />
                    </Border>
                    <Border Style="{StaticResource Badge}" Background="{StaticResource Brush.RemovedBadge}" Margin="5,0,0,0">
                        <TextBlock Style="{StaticResource BadgeText}" Text="нет в сборке" />
                    </Border>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.Overridden}" FontStyle="Italic"
                               Text="синий курсив — изменено вручную" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <DataGrid x:Name="Grid"
                      ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="{StaticResource Brush.GridLine}"
                      VerticalGridLinesBrush="{StaticResource Brush.GridLine}"
                      BorderThickness="0"
                      RowHeaderWidth="0"
                      MinRowHeight="27"
                      AllowDrop="True"
                      EnableRowVirtualization="True">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource Brush.GridHeader}" />
                        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Padding" Value="6,7" />
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.GridHeaderLine}" />
                        <Setter Property="BorderThickness" Value="0,0,1,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.NewRow}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.ChangedRow}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFileChanged}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.ChangedRow}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.RemovedRow}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.SectionRow}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.GroupRow}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.GroupText}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsReserve}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Reserve}" />
                                <Setter Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                            <!-- Выделение — последним, чтобы было видно и на подсвеченных строках. -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Selected}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <!-- Ячейки прозрачные: цвет строки (состояние, выделение) виден целиком, текст остаётся тёмным. -->
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.ContextMenu>
                    <ContextMenu x:Name="RowMenu">
                        <MenuItem Header="Свойства компонента…" InputGestureText="Alt+Enter" Command="{Binding EditComponentCommand}" FontWeight="SemiBold">
                            <MenuItem.Icon><Image Style="{StaticResource MenuIcon}" Source="{StaticResource Icon.Properties}" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Добавить изделие" InputGestureText="Insert" Command="{Binding AddItemCommand}">
                            <MenuItem.Icon><Image Style="{StaticResource MenuIcon}" Source="{StaticResource Icon.AddItem}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Добавить сторонний документ…" Command="{Binding AddExternalDocumentCommand}"
                                  Visibility="{Binding CanAddExternalDocument, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="Документ не из Inventor (PDF, Word…). Имя файла: «Обозначение-Наименование-Прочее». Наименование — тип документа по коду в обозначении, формат вписывается вручную." />
                        <MenuItem Header="Добавить текст" InputGestureText="Ctrl+T" Command="{Binding AddNoteCommand}">
                            <MenuItem.Icon><Image Style="{StaticResource MenuIcon}" Source="{StaticResource Icon.AddText}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Удалить строку" InputGestureText="Delete" Command="{Binding DeleteRowCommand}">
                            <MenuItem.Icon><Image Style="{StaticResource MenuIcon}" Source="{StaticResource Icon.Delete}" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Вверх" InputGestureText="Ctrl+↑" Command="{Binding MoveUpCommand}">
                            <MenuItem.Icon><Image Style="{StaticResource MenuIcon}" Source="{StaticResource Icon.Up}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Вниз" InputGestureText="Ctrl+↓" Command="{Binding MoveDownCommand}">
                            <MenuItem.Icon><Image Style="{StaticResource MenuIcon}" Source="{StaticResource Icon.Down}" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Перенести в раздел" ItemsSource="{Binding SectionOptions}">
                            <MenuItem.Icon><Image Style="{StaticResource MenuIcon}" Source="{StaticResource Icon.MoveToSection}" /></MenuItem.Icon>
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                    <EventSetter Event="Click" Handler="OnMoveToSectionClick" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <MenuItem Header="Перенести в группу" ItemsSource="{Binding GroupOptions}">
                            <MenuItem.Icon><Image Style="{StaticResource MenuIcon}" Source="{StaticResource Icon.Group}" /></MenuItem.Icon>
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                    <EventSetter Event="Click" Handler="OnMoveToGroupClick" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <MenuItem Header="Тип документа" ItemsSource="{Binding DocumentTypeOptions}"
                                  Visibility="{Binding CanSetDocumentType, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="Для строк раздела «Документация»: код в конце обозначения (СБ, ТУ, Э3…) и наименование документа">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                    <EventSetter Event="Click" Handler="OnDocumentTypeClick" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <MenuItem Header="Раздел по умолчанию" Command="{Binding ResetSectionsCommand}" CommandParameter="selected"
                                  ToolTip="Сбросить раздел выбранных компонентов к разделу по типу (стандартные изделия не трогаются)" />
                        <MenuItem Header="Удалить группу" Command="{Binding DeleteGroupCommand}" />
                        <MenuItem Header="Убрать пустой раздел" Command="{Binding HideSectionCommand}"
                                  ToolTip="Убрать вставленный раздел, в котором нет строк (выберите его заголовок)" />
                        <MenuItem Header="Примечание из детали" Command="{Binding InsertComponentNoteCommand}"
                                  ToolTip="Вставить в графу «Примечание» примечание из свойств детали (пользовательское свойство «Примечание» или «Комментарии»)">
                            <MenuItem.Icon><Image Style="{StaticResource MenuIcon}" Source="{StaticResource Icon.AddText}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Группа сортировки" ItemsSource="{Binding SortGroupOptions}"
                                  ToolTip="Только в этой спецификации, по умолчанию 0: внутри раздела меньшее число — выше. Применяется кнопкой «По ГОСТ».">
                            <MenuItem.Icon><Image Style="{StaticResource MenuIcon}" Source="{StaticResource Icon.Sort}" /></MenuItem.Icon>
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                    <EventSetter Event="Click" Handler="OnSortGroupClick" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Показать файл компонента в папке" Command="{Binding ShowComponentFileCommand}"
                                  Visibility="{Binding IsNotDocumentSelected, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="Открыть папку детали или сборки с выделенным файлом" />
                        <MenuItem Header="Показать чертёж в папке" Command="{Binding ShowDrawingFileCommand}"
                                  Visibility="{Binding IsNotDocumentSelected, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="Найти чертёж компонента в папках проекта и открыть его папку с выделенным файлом" />
                        <MenuItem Header="Показать документ в папке" Command="{Binding ShowDocumentFileCommand}"
                                  Visibility="{Binding IsDocumentSelected, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="Открыть папку документа (чертежа или стороннего файла) с выделенным файлом" />
                        <Separator />
                        <MenuItem x:Name="ClearOverrideItem" Header="Вернуть значение из компонента" Command="{Binding ClearOverrideCommand}">
                            <MenuItem.Icon><Image Style="{StaticResource MenuIcon}" Source="{StaticResource Icon.RestoreValue}" /></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <!-- Пустая спецификация. -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock HorizontalAlignment="Center" FontSize="15" Foreground="{StaticResource Brush.Muted}" Text="Спецификация пуста" />
                <TextBlock HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{StaticResource Brush.Muted}"
                           Text="Нажмите «Обновить из сборки» (F5), чтобы прочитать состав сборки." />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
