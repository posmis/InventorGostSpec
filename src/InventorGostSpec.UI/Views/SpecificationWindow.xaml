<Window x:Class="InventorGostSpec.UI.Views.SpecificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="1280"
        Height="780"
        MinWidth="900"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCommand}" />
        <KeyBinding Modifiers="Control" Key="Up" Command="{Binding MoveUpCommand}" />
        <KeyBinding Modifiers="Control" Key="Down" Command="{Binding MoveDownCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style TargetType="Button" x:Key="ToolButton">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="1,0" />
        </Style>
        <Style TargetType="Border" x:Key="Legend">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="10,0,4,0" />
            <Setter Property="BorderBrush" Value="#BBB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar>
                <Button Style="{StaticResource ToolButton}" Command="{Binding UpdateFromAssemblyCommand}" Content="Обновить из сборки"
                        ToolTip="Прочитать состав сборки. Ручной порядок, ручные строки и примечания сохраняются." />
                <Button Style="{StaticResource ToolButton}" Command="{Binding AcceptChangesCommand}" Content="Принять изменения"
                        ToolTip="Снять подсветку и удалить строки компонентов, которых нет в сборке" />
                <Separator />
                <Button Style="{StaticResource ToolButton}" Command="{Binding ResetCommand}" Content="Сбросить порядок"
                        ToolTip="Отсортировать по ГОСТ 2.106 и перенумеровать позиции" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding RenumberCommand}" Content="Перенумеровать"
                        ToolTip="Перенумеровать позиции в текущем порядке строк с учётом резерва" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding ReservesCommand}" Content="Резерв…"
                        ToolTip="Резерв номеров позиций по разделам" />
                <CheckBox Margin="6,0" VerticalAlignment="Center" IsChecked="{Binding ShowReserveRows}" Content="Показывать резерв" />
                <Separator />
                <Button Style="{StaticResource ToolButton}" Command="{Binding AddSectionCommand}" Content="Раздел…"
                        ToolTip="Добавить раздел" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding AddGroupCommand}" Content="Группа…"
                        ToolTip="Добавить группу «Изделия, устанавливаемые по …» (например, по электромонтажному чертежу)" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding AddItemCommand}" Content="+ Изделие"
                        ToolTip="Добавить строку изделия без модели в раздел выбранной строки" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding AddNoteCommand}" Content="+ Текст"
                        ToolTip="Добавить текстовую строку после выбранной" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding DeleteRowCommand}" Content="Удалить"
                        ToolTip="Удалить ручную строку или строку удалённого компонента" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding MoveUpCommand}" Content="▲"
                        ToolTip="Переместить вверх (Ctrl+↑)" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding MoveDownCommand}" Content="▼"
                        ToolTip="Переместить вниз (Ctrl+↓)" />
                <Separator />
                <Button Style="{StaticResource ToolButton}" Command="{Binding WritePositionsCommand}" Content="Позиции в BOM"
                        ToolTip="Сохранить и записать номера позиций в спецификацию Inventor (BOM)" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding SaveCommand}" Content="Сохранить" FontWeight="SemiBold"
                        ToolTip="Записать спецификацию в файл сборки (Ctrl+S)" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource Legend}" Background="#E3F4E6" />
                    <TextBlock Text="новый" />
                    <Border Style="{StaticResource Legend}" Background="#FFF4CC" />
                    <TextBlock Text="изменён" />
                    <Border Style="{StaticResource Legend}" Background="#FBE1E1" />
                    <TextBlock Text="нет в сборке" />
                    <TextBlock Margin="10,0,0,0" Foreground="#1F5FBF" FontStyle="Italic" Text="значение изменено вручную" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <DataGrid x:Name="Grid"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#DDD"
                  VerticalGridLinesBrush="#DDD"
                  RowHeaderWidth="0"
                  AllowDrop="True"
                  EnableRowVirtualization="True">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNew}" Value="True">
                            <Setter Property="Background" Value="#E3F4E6" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsChanged}" Value="True">
                            <Setter Property="Background" Value="#FFF4CC" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                            <Setter Property="Background" Value="#FBE1E1" />
                            <Setter Property="Foreground" Value="#888" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                            <Setter Property="Background" Value="#F2F2F2" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                            <Setter Property="Background" Value="#E1ECF7" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsReserve}" Value="True">
                            <Setter Property="Foreground" Value="#AAA" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.ContextMenu>
                <ContextMenu x:Name="RowMenu">
                    <MenuItem Header="Добавить изделие" Command="{Binding AddItemCommand}" />
                    <MenuItem Header="Добавить текст" Command="{Binding AddNoteCommand}" />
                    <MenuItem Header="Удалить строку" Command="{Binding DeleteRowCommand}" />
                    <Separator />
                    <MenuItem Header="Вверх" InputGestureText="Ctrl+↑" Command="{Binding MoveUpCommand}" />
                    <MenuItem Header="Вниз" InputGestureText="Ctrl+↓" Command="{Binding MoveDownCommand}" />
                    <MenuItem Header="Перенести в раздел" ItemsSource="{Binding SectionOptions}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding Name}" />
                                <EventSetter Event="Click" Handler="OnMoveToSectionClick" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <MenuItem Header="Перенести в группу" ItemsSource="{Binding GroupOptions}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding Name}" />
                                <EventSetter Event="Click" Handler="OnMoveToGroupClick" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <MenuItem Header="Удалить группу" Command="{Binding DeleteGroupCommand}" />
                    <Separator />
                    <MenuItem x:Name="ClearOverrideItem" Header="Вернуть значение из компонента" Command="{Binding ClearOverrideCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </DockPanel>
</Window>
