<Window x:Class="InventorGostSpec.UI.Views.SpecificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:InventorGostSpec.UI.Controls"
        Title="{Binding Title}"
        Width="1320"
        Height="800"
        MinWidth="960"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/InventorGostSpec.UI;component/Themes/Icons.xaml" />
                <ResourceDictionary Source="/InventorGostSpec.UI;component/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <Style TargetType="Border" x:Key="Legend">
                <Setter Property="Width" Value="12" />
                <Setter Property="Height" Value="12" />
                <Setter Property="Margin" Value="12,0,4,0" />
                <Setter Property="BorderBrush" Value="#BBB" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="2" />
            </Style>
            <Style TargetType="Image" x:Key="MenuIcon">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding UpdateFromAssemblyCommand}" />
        <KeyBinding Key="F3" Command="{Binding NextChangeCommand}" />
        <KeyBinding Modifiers="Alt" Key="Enter" Command="{Binding EditComponentCommand}" />
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Insert" Command="{Binding AddItemCommand}" />
        <KeyBinding Modifiers="Control" Key="T" Command="{Binding AddNoteCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteRowCommand}" />
        <KeyBinding Modifiers="Control" Key="Up" Command="{Binding MoveUpCommand}" />
        <KeyBinding Modifiers="Control" Key="Down" Command="{Binding MoveDownCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Панель команд, сгруппированная по смыслу. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Bar}" BorderBrush="{StaticResource Brush.BarBorder}" BorderThickness="0,0,0,1">
            <DockPanel Margin="4,0">
                <!-- Поиск -->
                <Border DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,6,0" Width="280" Height="28"
                        Background="White" BorderBrush="{StaticResource Brush.BarBorder}" BorderThickness="1" CornerRadius="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Source="{StaticResource Icon.Search}" Width="14" Height="14" Margin="7,0,4,0" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" VerticalContentAlignment="Center" Background="Transparent"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                 ToolTip="Поиск по обозначению, наименованию, примечанию, позиции (Ctrl+F). Esc — очистить." />
                        <TextBlock Grid.Column="1" Margin="3,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="#9CA3AF" Text="Поиск (Ctrl+F)">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <controls:IconButton Grid.Column="2" Icon="{StaticResource Icon.Close}" Padding="3" Margin="0,0,2,0"
                                             Command="{Binding ClearSearchCommand}" ToolTip="Очистить поиск (Esc)"
                                             Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>

                <WrapPanel>
                    <HeaderedContentControl Style="{StaticResource CommandGroup}" Header="Сборка">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconButton Icon="{StaticResource Icon.Refresh}" Text="Обновить из сборки" Command="{Binding UpdateFromAssemblyCommand}"
                                                 ToolTip="Прочитать состав сборки (F5). Ручной порядок, ручные строки, примечания и правки сохраняются." />
                            <controls:IconButton Icon="{StaticResource Icon.NextChange}" Text="Следующее изменение" Command="{Binding NextChangeCommand}"
                                                 ToolTip="Перейти к следующей подсвеченной строке (F3)" />
                            <controls:IconButton Icon="{StaticResource Icon.Accept}" Text="Принять" Command="{Binding AcceptChangesCommand}"
                                                 ToolTip="Принять изменения: снять подсветку и удалить строки компонентов, которых нет в сборке" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Style="{StaticResource CommandGroup}" Header="Строки">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconButton Icon="{StaticResource Icon.Properties}" Text="Свойства" Command="{Binding EditComponentCommand}"
                                                 ToolTip="Свойства компонента: раздел, формат, единица, поля сортировки (Alt+Enter). Записываются в iProperties детали." />
                            <controls:IconButton Icon="{StaticResource Icon.AddItem}" Text="Изделие" Command="{Binding AddItemCommand}"
                                                 ToolTip="Добавить строку изделия без модели после выбранной (Insert). Номер позиции — из резерва раздела." />
                            <controls:IconButton Icon="{StaticResource Icon.AddText}" Text="Текст" Command="{Binding AddNoteCommand}"
                                                 ToolTip="Добавить текстовую строку после выбранной (Ctrl+T)" />
                            <controls:IconButton Icon="{StaticResource Icon.Delete}" Command="{Binding DeleteRowCommand}"
                                                 ToolTip="Удалить ручную строку или строку компонента, которого нет в сборке (Delete)" />
                            <controls:IconButton Icon="{StaticResource Icon.Up}" Command="{Binding MoveUpCommand}"
                                                 ToolTip="Переместить вверх внутри раздела (Ctrl+↑). Можно перетаскивать за «⋮⋮»." />
                            <controls:IconButton Icon="{StaticResource Icon.Down}" Command="{Binding MoveDownCommand}"
                                                 ToolTip="Переместить вниз внутри раздела (Ctrl+↓)" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Style="{StaticResource CommandGroup}" Header="Структура">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconButton Icon="{StaticResource Icon.Section}" Text="Раздел" Command="{Binding AddSectionCommand}"
                                                 ToolTip="Добавить раздел в эту спецификацию или в общий справочник" />
                            <controls:IconButton Icon="{StaticResource Icon.Group}" Text="Группа" Command="{Binding AddGroupCommand}"
                                                 ToolTip="Добавить группу «Изделия, устанавливаемые по …» (например, по электромонтажному чертежу)" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Style="{StaticResource CommandGroup}" Header="Позиции">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconButton Icon="{StaticResource Icon.Sort}" Text="По ГОСТ" Command="{Binding ResetCommand}"
                                                 ToolTip="Сбросить ручной порядок: отсортировать по ГОСТ 2.106 и перенумеровать позиции" />
                            <controls:IconButton Icon="{StaticResource Icon.Renumber}" Text="Перенумеровать" Command="{Binding RenumberCommand}"
                                                 ToolTip="Перенумеровать позиции в текущем порядке строк с учётом резерва" />
                            <controls:IconButton Icon="{StaticResource Icon.Reserve}" Text="Резерв" Command="{Binding ReservesCommand}"
                                                 ToolTip="Резерв номеров позиций по разделам — для основной части и каждой группы" />
                            <CheckBox Margin="6,0,2,0" VerticalAlignment="Center" IsChecked="{Binding ShowReserveRows}" Content="Показывать резерв"
                                      ToolTip="Показывать пустые строки резервных позиций" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Style="{StaticResource CommandGroup}" Header="Inventor">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconButton Icon="{StaticResource Icon.Balloon}" Text="Позиции в BOM" Command="{Binding WritePositionsCommand}"
                                                 ToolTip="Сохранить спецификацию и записать номера позиций в спецификацию Inventor (BOM), чтобы выноски совпадали" />
                        </StackPanel>
                    </HeaderedContentControl>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Нижняя панель: состояние, легенда, сохранение. -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.Bar}" BorderBrush="{StaticResource Brush.BarBorder}" BorderThickness="0,1,0,0" Padding="10,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <controls:IconButton IsPrimary="True" Text="Сохранить" Padding="16,5" Command="{Binding SaveCommand}"
                                         ToolTip="Записать спецификацию в файл сборки (Ctrl+S). Затем сохраните сборку." />
                    <controls:IconButton Text="Закрыть" Padding="14,5" Margin="6,0,0,0" Click="OnCloseClick" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Foreground="#374151" />
                    <Border Style="{StaticResource Legend}" Background="#E3F4E6" Margin="20,0,4,0" />
                    <TextBlock Text="новый" Foreground="{StaticResource Brush.Muted}" />
                    <Border Style="{StaticResource Legend}" Background="#FFF4CC" />
                    <TextBlock Text="изменён" Foreground="{StaticResource Brush.Muted}" />
                    <Border Style="{StaticResource Legend}" Background="#FBE1E1" />
                    <TextBlock Text="нет в сборке" Foreground="{StaticResource Brush.Muted}" />
                    <TextBlock Margin="12,0,0,0" Foreground="#1F5FBF" FontStyle="Italic" Text="изменено вручную" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <DataGrid x:Name="Grid"
                      ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#E5E7EB"
                      VerticalGridLinesBrush="#E5E7EB"
                      BorderThickness="0"
                      RowHeaderWidth="0"
                      MinRowHeight="24"
                      AllowDrop="True"
                      EnableRowVirtualization="True">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#EEF1F5" />
                        <Setter Property="Foreground" Value="#374151" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="6,5" />
                        <Setter Property="BorderBrush" Value="#D9DDE3" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                <Setter Property="Background" Value="#E3F4E6" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                <Setter Property="Background" Value="#FFF4CC" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                                <Setter Property="Background" Value="#FBE1E1" />
                                <Setter Property="Foreground" Value="#888" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                <Setter Property="Background" Value="#F7F8FA" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                                <Setter Property="Background" Value="#E1ECF7" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsReserve}" Value="True">
                                <Setter Property="Foreground" Value="#B0B6BF" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.ContextMenu>
                    <ContextMenu x:Name="RowMenu">
                        <MenuItem Header="Свойства компонента…" InputGestureText="Alt+Enter" Command="{Binding EditComponentCommand}" FontWeight="SemiBold">
                            <MenuItem.Icon><Image Style="{StaticResource MenuIcon}" Source="{StaticResource Icon.Properties}" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Добавить изделие" InputGestureText="Insert" Command="{Binding AddItemCommand}">
                            <MenuItem.Icon><Image Style="{StaticResource MenuIcon}" Source="{StaticResource Icon.AddItem}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Добавить текст" InputGestureText="Ctrl+T" Command="{Binding AddNoteCommand}">
                            <MenuItem.Icon><Image Style="{StaticResource MenuIcon}" Source="{StaticResource Icon.AddText}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Удалить строку" InputGestureText="Delete" Command="{Binding DeleteRowCommand}">
                            <MenuItem.Icon><Image Style="{StaticResource MenuIcon}" Source="{StaticResource Icon.Delete}" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Вверх" InputGestureText="Ctrl+↑" Command="{Binding MoveUpCommand}">
                            <MenuItem.Icon><Image Style="{StaticResource MenuIcon}" Source="{StaticResource Icon.Up}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Вниз" InputGestureText="Ctrl+↓" Command="{Binding MoveDownCommand}">
                            <MenuItem.Icon><Image Style="{StaticResource MenuIcon}" Source="{StaticResource Icon.Down}" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Перенести в раздел" ItemsSource="{Binding SectionOptions}">
                            <MenuItem.Icon><Image Style="{StaticResource MenuIcon}" Source="{StaticResource Icon.MoveToSection}" /></MenuItem.Icon>
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                    <EventSetter Event="Click" Handler="OnMoveToSectionClick" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <MenuItem Header="Перенести в группу" ItemsSource="{Binding GroupOptions}">
                            <MenuItem.Icon><Image Style="{StaticResource MenuIcon}" Source="{StaticResource Icon.Group}" /></MenuItem.Icon>
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                    <EventSetter Event="Click" Handler="OnMoveToGroupClick" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <MenuItem Header="Удалить группу" Command="{Binding DeleteGroupCommand}" />
                        <MenuItem Header="Примечание из детали" Command="{Binding InsertComponentNoteCommand}"
                                  ToolTip="Вставить в графу «Примечание» примечание из свойств детали (пользовательское свойство «Примечание» или «Комментарии»)">
                            <MenuItem.Icon><Image Style="{StaticResource MenuIcon}" Source="{StaticResource Icon.AddText}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Группа сортировки" ItemsSource="{Binding SortGroupOptions}"
                                  ToolTip="Только в этой спецификации, по умолчанию 0: внутри раздела меньшее число — выше. Применяется кнопкой «По ГОСТ».">
                            <MenuItem.Icon><Image Style="{StaticResource MenuIcon}" Source="{StaticResource Icon.Sort}" /></MenuItem.Icon>
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                    <EventSetter Event="Click" Handler="OnSortGroupClick" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <Separator />
                        <MenuItem x:Name="ClearOverrideItem" Header="Вернуть значение из компонента" Command="{Binding ClearOverrideCommand}">
                            <MenuItem.Icon><Image Style="{StaticResource MenuIcon}" Source="{StaticResource Icon.RestoreValue}" /></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <!-- Пустая спецификация. -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock HorizontalAlignment="Center" FontSize="15" Foreground="{StaticResource Brush.Muted}" Text="Спецификация пуста" />
                <TextBlock HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{StaticResource Brush.Muted}"
                           Text="Нажмите «Обновить из сборки» (F5), чтобы прочитать состав сборки." />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
